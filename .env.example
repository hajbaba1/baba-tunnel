# Fenix Standalone Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Do NOT store actual secrets, private tokens, or passwords in git.

PORT=3000
HOST=127.0.0.1
FENIX_SOCKS_PORT=10808
FENIX_HTTP_PORT=10809
DEBUG=false

# Optional custom path to xray.exe (defaults to core/xray.exe inside project)
# FENIX_XRAY_PATH=C:\path\to\xray.exe

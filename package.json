{
  "name": "baba-tunnel",
  "version": "1.0.0",
  "description": "BABA Tunnel (BBT) — Powered by Mozilla VPN MASQUE proxy infrastructure and Xray-core",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node server.js --port=3000",
    "test": "node --test tests/**/*.test.js",
    "test:imports": "node scripts/check-imports.js",
    "dist": "electron-builder --win",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "org.baba.tunnel",
    "productName": "BABA Tunnel",
    "compression": "maximum",
    "electronLanguages": [
      "fa",
      "en"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BABA Tunnel"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "files": [
      "*.js",
      "public/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "express": "^4.21.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "license": "SEE LICENSE IN LICENSE",
  "allowScripts": {
    "electron@34.5.8": true
  }
}
